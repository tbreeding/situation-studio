generator client {
  provider     = "prisma-client"
  output       = "../generated"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum UserState {
  ACTIVE
  DEACTIVATED
}

enum UserRoleCode {
  EDITOR
  ADMIN
}

enum ThrottleKeyKind {
  USERNAME
  IP
}

enum ResetTokenState {
  ACTIVE
  CONSUMED
  REVOKED
}

enum SituationVisibility {
  PUBLIC
  RETIRED
  UNPUBLISHED
}

enum DraftLineageState {
  ACTIVE
  ARCHIVED
}

enum ArtifactKind {
  SITUATION
  GUIDE
  PRACTICE
  SOURCE
  LESSON_PLAN
  PREPARATION_PROMPT
  PROMOTION
}

enum ArtifactVisibility {
  GLOBAL
  SITUATION_SCOPED
  INTERNAL
}

enum ContentEncoding {
  UTF8
  BINARY
}

enum ReviewJobState {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum ReviewStepState {
  PENDING
  READY
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum AgentFailureClass {
  PROVIDER_CAPACITY
  PROVIDER_TRANSIENT
  PROVIDER_AUTH
  OUTPUT_INVALID
  APPLICATION
  CANCELLED
}

enum ProposalChangeState {
  PENDING
  ACCEPTED
  REJECTED
}

enum ProposalTargetKind {
  SECTION
  METADATA
  SCOPED_VARIANT
  RELATIONSHIP
}

enum PublicationJobState {
  REQUESTED
  ASSEMBLING
  NEEDS_REFRESH
  PROMOTING
  VERIFYING
  SUCCEEDED
  RESTORED
  RECOVERY_REQUIRED
  FAILED
}

enum ProductionSourceKind {
  BOOTSTRAP_IMPORT
  EXTERNAL_IMPORT
  MANUAL
  AGENT_ASSISTED
  RESTORE
  CREATE
  RETIRE
}

enum PublicationEventKind {
  REQUESTED
  POINTER_OBSERVED
  REBASED
  CONFLICTED
  SNAPSHOT_BUILT
  VALIDATED
  RELEASE_INSERTED
  POINTER_ADVANCED
  VERIFIED
  RESTORE_STARTED
  RESTORED
  RECOVERY_REQUIRED
  SUCCEEDED
  FAILED
}

enum BackupState {
  QUEUED
  RUNNING
  VERIFIED
  FAILED
}

model User {
  id                 String                       @id @default(uuid()) @db.Uuid
  username           String                       @unique @db.VarChar(64)
  displayName        String                       @map("display_name") @db.VarChar(120)
  passwordHash       String                       @map("password_hash") @db.VarChar(512)
  passwordVersion    Int                          @default(1) @map("password_version")
  state              UserState                    @default(ACTIVE)
  lastLoginAt        DateTime?                    @map("last_login_at") @db.Timestamptz(3)
  deactivatedAt      DateTime?                    @map("deactivated_at") @db.Timestamptz(3)
  createdAt          DateTime                     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(3)
  roles              UserRoleAssignment[]
  sessions           Session[]
  resetTokens        PasswordResetToken[]         @relation("ResetSubject")
  resetTokensCreated PasswordResetToken[]         @relation("ResetCreator")
  checkouts          SituationCheckout[]          @relation("CheckoutHolder")
  checkoutsForced    SituationCheckout[]          @relation("CheckoutForceActor")
  revisions          DraftRevision[]
  productionVersions ProductionSituationVersion[]
  auditEvents        AuditEvent[]                 @relation("AuditActor")

  @@index([state, username], map: "users_state_username_idx")
  @@map("users")
}

model UserRoleAssignment {
  userId    String       @map("user_id") @db.Uuid
  role      UserRoleCode
  grantedAt DateTime     @default(now()) @map("granted_at") @db.Timestamptz(3)
  user      User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([userId, role])
  @@map("user_role_assignments")
}

model Session {
  id                String    @id @default(uuid()) @db.Uuid
  tokenHash         String    @unique @map("token_hash") @db.Char(64)
  csrfHash          String    @map("csrf_hash") @db.Char(64)
  userId            String    @map("user_id") @db.Uuid
  passwordVersion   Int       @map("password_version")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt        DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  idleExpiresAt     DateTime  @map("idle_expires_at") @db.Timestamptz(3)
  absoluteExpiresAt DateTime  @map("absolute_expires_at") @db.Timestamptz(3)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedReason     String?   @map("revoked_reason") @db.VarChar(200)
  ipHash            String?   @map("ip_hash") @db.Char(64)
  user              User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, absoluteExpiresAt], map: "sessions_user_expiry_idx")
  @@map("sessions")
}

model LoginThrottle {
  id              String          @id @default(uuid()) @db.Uuid
  keyKind         ThrottleKeyKind @map("key_kind")
  keyHash         String          @map("key_hash") @db.Char(64)
  failureCount    Int             @default(0) @map("failure_count")
  windowStartedAt DateTime        @map("window_started_at") @db.Timestamptz(3)
  blockedUntil    DateTime?       @map("blocked_until") @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([keyKind, keyHash], map: "login_throttles_key_key")
  @@index([blockedUntil], map: "login_throttles_blocked_idx")
  @@map("login_throttles")
}

model PasswordResetToken {
  id          String          @id @default(uuid()) @db.Uuid
  userId      String          @map("user_id") @db.Uuid
  tokenHash   String          @unique @map("token_hash") @db.Char(64)
  state       ResetTokenState @default(ACTIVE)
  createdById String          @map("created_by_id") @db.Uuid
  expiresAt   DateTime        @map("expires_at") @db.Timestamptz(3)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  consumedAt  DateTime?       @map("consumed_at") @db.Timestamptz(3)
  user        User            @relation("ResetSubject", fields: [userId], references: [id], onDelete: Restrict)
  createdBy   User            @relation("ResetCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([userId, state, expiresAt], map: "password_reset_subject_idx")
  @@map("password_reset_tokens")
}

model Situation {
  id                   String                       @id @default(uuid()) @db.Uuid
  slug                 String                       @unique @db.VarChar(160)
  title                String                       @db.VarChar(300)
  visibility           SituationVisibility          @default(UNPUBLISHED)
  fence                BigInt                       @default(0)
  productionBundleHash String?                      @map("production_bundle_hash") @db.Char(64)
  productionReleaseId  String?                      @map("production_release_id") @db.Uuid
  productionAt         DateTime?                    @map("production_at") @db.Timestamptz(3)
  createdAt            DateTime                     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(3)
  checkouts            SituationCheckout[]
  drafts               Draft[]
  variants             ScopedArtifactVariant[]
  productionVersions   ProductionSituationVersion[]
  reviewJobs           ReviewJob[]
  publicationJobs      PublicationJob[]

  @@index([visibility, title], map: "situations_inventory_idx")
  @@map("situations")
}

model SituationCheckout {
  id                 String    @id @default(uuid()) @db.Uuid
  situationId        String    @map("situation_id") @db.Uuid
  holderId           String    @map("holder_id") @db.Uuid
  draftId            String    @map("draft_id") @db.Uuid
  fence              BigInt
  acquiredAt         DateTime  @default(now()) @map("acquired_at") @db.Timestamptz(3)
  releasedAt         DateTime? @map("released_at") @db.Timestamptz(3)
  releaseReason      String?   @map("release_reason") @db.VarChar(240)
  forcedById         String?   @map("forced_by_id") @db.Uuid
  forceReason        String?   @map("force_reason") @db.VarChar(500)
  resultingDraftHash String?   @map("resulting_draft_hash") @db.Char(64)
  situation          Situation @relation(fields: [situationId], references: [id], onDelete: Restrict)
  holder             User      @relation("CheckoutHolder", fields: [holderId], references: [id], onDelete: Restrict)
  forcedBy           User?     @relation("CheckoutForceActor", fields: [forcedById], references: [id], onDelete: Restrict)
  draft              Draft     @relation(fields: [draftId], references: [id], onDelete: Restrict)

  @@index([holderId, releasedAt], map: "checkouts_holder_active_idx")
  @@index([situationId, releasedAt], map: "checkouts_situation_active_idx")
  @@map("situation_checkouts")
}

model ContentBlob {
  hash                String                      @id @db.Char(64)
  encoding            ContentEncoding             @default(UTF8)
  mediaType           String                      @map("media_type") @db.VarChar(120)
  byteLength          Int                         @map("byte_length")
  textBody            String?                     @map("text_body") @db.Text
  binaryBody          Bytes?                      @map("binary_body") @db.ByteA
  createdAt           DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)
  draftArtifacts      DraftRevisionArtifact[]
  productionArtifacts ProductionVersionArtifact[]
  variants            ScopedArtifactVariant[]

  @@map("content_blobs")
}

model Draft {
  id                      String                      @id @default(uuid()) @db.Uuid
  situationId             String                      @map("situation_id") @db.Uuid
  lineage                 Int                         @default(1)
  state                   DraftLineageState           @default(ACTIVE)
  baseProductionVersionId String?                     @map("base_production_version_id") @db.Uuid
  baseReleaseId           String?                     @map("base_release_id") @db.Uuid
  baseManifestHash        String?                     @map("base_manifest_hash") @db.Char(64)
  basePointerGeneration   BigInt?                     @map("base_pointer_generation")
  baseBundleHash          String?                     @map("base_bundle_hash") @db.Char(64)
  restorationParentId     String?                     @map("restoration_parent_id") @db.Uuid
  rebaseReleaseId         String?                     @map("rebase_release_id") @db.Uuid
  conflictedAt            DateTime?                   @map("conflicted_at") @db.Timestamptz(3)
  currentRevisionNumber   Int                         @default(0) @map("current_revision_number")
  currentBundleHash       String?                     @map("current_bundle_hash") @db.Char(64)
  archivedAt              DateTime?                   @map("archived_at") @db.Timestamptz(3)
  createdAt               DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(3)
  situation               Situation                   @relation(fields: [situationId], references: [id], onDelete: Restrict)
  baseProductionVersion   ProductionSituationVersion? @relation("DraftBaseVersion", fields: [baseProductionVersionId], references: [id], onDelete: Restrict)
  revisions               DraftRevision[]
  checkouts               SituationCheckout[]

  @@index([situationId, state], map: "drafts_situation_state_idx")
  @@map("drafts")
}

model DraftRevision {
  id               String                  @id @default(uuid()) @db.Uuid
  draftId          String                  @map("draft_id") @db.Uuid
  revision         Int
  parentId         String?                 @map("parent_id") @db.Uuid
  bundleHash       String                  @map("bundle_hash") @db.Char(64)
  bundleManifest   Json                    @map("bundle_manifest")
  contractVersion  String                  @map("contract_version") @db.VarChar(100)
  validationPolicy String                  @map("validation_policy") @db.VarChar(100)
  actorId          String                  @map("actor_id") @db.Uuid
  namedCheckpoint  String?                 @map("named_checkpoint") @db.VarChar(160)
  createdAt        DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  draft            Draft                   @relation(fields: [draftId], references: [id], onDelete: Restrict)
  parent           DraftRevision?          @relation("DraftRevisionLineage", fields: [parentId], references: [id], onDelete: Restrict)
  children         DraftRevision[]         @relation("DraftRevisionLineage")
  actor            User                    @relation(fields: [actorId], references: [id], onDelete: Restrict)
  artifacts        DraftRevisionArtifact[]
  reviewJobs       ReviewJob[]
  publicationJobs  PublicationJob[]

  @@unique([draftId, revision], map: "draft_revisions_number_key")
  @@index([draftId, createdAt], map: "draft_revisions_timeline_idx")
  @@map("draft_revisions")
}

model DraftRevisionArtifact {
  revisionId  String             @map("revision_id") @db.Uuid
  logicalId   String             @map("logical_id") @db.VarChar(240)
  kind        ArtifactKind
  visibility  ArtifactVisibility
  contentHash String             @map("content_hash") @db.Char(64)
  position    Int
  metadata    Json?
  revision    DraftRevision      @relation(fields: [revisionId], references: [id], onDelete: Restrict)
  content     ContentBlob        @relation(fields: [contentHash], references: [hash], onDelete: Restrict)

  @@id([revisionId, logicalId])
  @@unique([revisionId, position], map: "draft_revision_artifact_position_key")
  @@map("draft_revision_artifacts")
}

model ScopedArtifactVariant {
  id                    String             @id @default(uuid()) @db.Uuid
  ownerSituationId      String             @map("owner_situation_id") @db.Uuid
  logicalId             String             @unique @map("logical_id") @db.VarChar(240)
  kind                  ArtifactKind
  visibility            ArtifactVisibility
  forkedFromLogicalId   String             @map("forked_from_logical_id") @db.VarChar(240)
  forkedFromContentHash String             @map("forked_from_content_hash") @db.Char(64)
  contentHash           String             @map("content_hash") @db.Char(64)
  createdAt             DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  ownerSituation        Situation          @relation(fields: [ownerSituationId], references: [id], onDelete: Restrict)
  content               ContentBlob        @relation(fields: [contentHash], references: [hash], onDelete: Restrict)

  @@index([ownerSituationId, kind], map: "scoped_variants_owner_kind_idx")
  @@map("scoped_artifact_variants")
}

model LeadershipReleaseObservation {
  id                String                       @id @default(uuid()) @db.Uuid
  releaseId         String                       @unique @map("release_id") @db.Uuid
  manifestHash      String                       @map("manifest_hash") @db.Char(64)
  pointerGeneration BigInt?                      @map("pointer_generation")
  state             String                       @db.VarChar(40)
  sourceKind        String                       @map("source_kind") @db.VarChar(80)
  manifest          Json
  observedAt        DateTime                     @default(now()) @map("observed_at") @db.Timestamptz(3)
  publishedAt       DateTime?                    @map("published_at") @db.Timestamptz(3)
  versions          ProductionSituationVersion[]

  @@index([observedAt], map: "leadership_observations_time_idx")
  @@map("leadership_release_observations")
}

model LeadershipSyncCursor {
  id                    String    @id @default("official") @db.VarChar(40)
  lastReleaseId         String?   @map("last_release_id") @db.Uuid
  lastManifestHash      String?   @map("last_manifest_hash") @db.Char(64)
  lastPointerGeneration BigInt?   @map("last_pointer_generation")
  lastSuccessfulAt      DateTime? @map("last_successful_at") @db.Timestamptz(3)
  lastErrorCode         String?   @map("last_error_code") @db.VarChar(100)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("leadership_sync_cursors")
}

model ProductionSituationVersion {
  id                  String                       @id @default(uuid()) @db.Uuid
  situationId         String                       @map("situation_id") @db.Uuid
  observationId       String                       @map("observation_id") @db.Uuid
  bundleHash          String                       @map("bundle_hash") @db.Char(64)
  bundleManifest      Json                         @map("bundle_manifest")
  contractVersion     String                       @map("contract_version") @db.VarChar(100)
  validationPolicy    String                       @map("validation_policy") @db.VarChar(100)
  sourceKind          ProductionSourceKind         @map("source_kind")
  actorId             String?                      @map("actor_id") @db.Uuid
  productionAt        DateTime                     @map("production_at") @db.Timestamptz(3)
  changeSummary       String                       @map("change_summary") @db.VarChar(1000)
  editorNote          String?                      @map("editor_note") @db.VarChar(1000)
  restorationParentId String?                      @map("restoration_parent_id") @db.Uuid
  createdAt           DateTime                     @default(now()) @map("created_at") @db.Timestamptz(3)
  situation           Situation                    @relation(fields: [situationId], references: [id], onDelete: Restrict)
  observation         LeadershipReleaseObservation @relation(fields: [observationId], references: [id], onDelete: Restrict)
  actor               User?                        @relation(fields: [actorId], references: [id], onDelete: Restrict)
  restorationParent   ProductionSituationVersion?  @relation("ProductionRestoration", fields: [restorationParentId], references: [id], onDelete: Restrict)
  restorations        ProductionSituationVersion[] @relation("ProductionRestoration")
  artifacts           ProductionVersionArtifact[]
  draftsBasedOn       Draft[]                      @relation("DraftBaseVersion")

  @@unique([situationId, observationId], map: "production_versions_observation_key")
  @@index([situationId, bundleHash], map: "production_versions_bundle_idx")
  @@index([situationId, productionAt], map: "production_versions_timeline_idx")
  @@map("production_situation_versions")
}

model ProductionVersionArtifact {
  versionId   String                     @map("version_id") @db.Uuid
  logicalId   String                     @map("logical_id") @db.VarChar(240)
  kind        ArtifactKind
  visibility  ArtifactVisibility
  contentHash String                     @map("content_hash") @db.Char(64)
  position    Int
  metadata    Json?
  version     ProductionSituationVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)
  content     ContentBlob                @relation(fields: [contentHash], references: [hash], onDelete: Restrict)

  @@id([versionId, logicalId])
  @@unique([versionId, position], map: "production_version_artifact_position_key")
  @@map("production_version_artifacts")
}

model ReviewJob {
  id                 String          @id @default(uuid()) @db.Uuid
  situationId        String          @map("situation_id") @db.Uuid
  inputRevisionId    String          @map("input_revision_id") @db.Uuid
  checkoutId         String          @map("checkout_id") @db.Uuid
  checkoutFence      BigInt          @map("checkout_fence")
  fence              BigInt          @default(1)
  state              ReviewJobState  @default(QUEUED)
  contextHash        String          @map("context_hash") @db.Char(64)
  contractVersion    String          @map("contract_version") @db.VarChar(100)
  policyVersion      String          @map("policy_version") @db.VarChar(100)
  queuedAt           DateTime        @default(now()) @map("queued_at") @db.Timestamptz(3)
  startedAt          DateTime?       @map("started_at") @db.Timestamptz(3)
  finishedAt         DateTime?       @map("finished_at") @db.Timestamptz(3)
  claimToken         String?         @map("claim_token") @db.Uuid
  leaseExpiresAt     DateTime?       @map("lease_expires_at") @db.Timestamptz(3)
  cancelledAt        DateTime?       @map("cancelled_at") @db.Timestamptz(3)
  cancelledById      String?         @map("cancelled_by_id") @db.Uuid
  cancellationReason String?         @map("cancellation_reason") @db.VarChar(500)
  failureCode        String?         @map("failure_code") @db.VarChar(100)
  situation          Situation       @relation(fields: [situationId], references: [id], onDelete: Restrict)
  inputRevision      DraftRevision   @relation(fields: [inputRevisionId], references: [id], onDelete: Restrict)
  steps              ReviewStep[]
  proposal           ReviewProposal?

  @@index([state, queuedAt], map: "review_jobs_queue_idx")
  @@index([situationId, state], map: "review_jobs_situation_state_idx")
  @@map("review_jobs")
}

model ReviewStep {
  id           String          @id @default(uuid()) @db.Uuid
  jobId        String          @map("job_id") @db.Uuid
  ordinal      Int
  roleCode     String          @map("role_code") @db.VarChar(100)
  dependencies Json
  state        ReviewStepState @default(PENDING)
  outputHash   String?         @map("output_hash") @db.Char(64)
  startedAt    DateTime?       @map("started_at") @db.Timestamptz(3)
  finishedAt   DateTime?       @map("finished_at") @db.Timestamptz(3)
  job          ReviewJob       @relation(fields: [jobId], references: [id], onDelete: Restrict)
  runs         AgentRun[]

  @@unique([jobId, ordinal], map: "review_steps_ordinal_key")
  @@unique([jobId, roleCode], map: "review_steps_role_key")
  @@index([jobId, state, ordinal], map: "review_steps_ready_idx")
  @@map("review_steps")
}

model AgentRun {
  id                String             @id @default(uuid()) @db.Uuid
  stepId            String             @map("step_id") @db.Uuid
  attempt           Int
  requestedProvider String             @map("requested_provider") @db.VarChar(40)
  resolvedProvider  String?            @map("resolved_provider") @db.VarChar(40)
  requestedModel    String             @map("requested_model") @db.VarChar(120)
  resolvedModel     String?            @map("resolved_model") @db.VarChar(120)
  reasoningEffort   String             @map("reasoning_effort") @db.VarChar(30)
  evidenceHash      String             @map("evidence_hash") @db.Char(64)
  structuredOutput  Json?              @map("structured_output")
  outputHash        String?            @map("output_hash") @db.Char(64)
  inputTokens       Int?               @map("input_tokens")
  outputTokens      Int?               @map("output_tokens")
  usageEstimated    Boolean?           @map("usage_estimated")
  failureClass      AgentFailureClass? @map("failure_class")
  retryable         Boolean?
  startedAt         DateTime           @default(now()) @map("started_at") @db.Timestamptz(3)
  finishedAt        DateTime?          @map("finished_at") @db.Timestamptz(3)
  step              ReviewStep         @relation(fields: [stepId], references: [id], onDelete: Restrict)

  @@unique([stepId, attempt], map: "agent_runs_attempt_key")
  @@map("agent_runs")
}

model ReviewProposal {
  id              String           @id @default(uuid()) @db.Uuid
  jobId           String           @unique @map("job_id") @db.Uuid
  inputRevisionId String           @map("input_revision_id") @db.Uuid
  summary         String           @db.Text
  findings        Json
  proposalHash    String           @unique @map("proposal_hash") @db.Char(64)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  job             ReviewJob        @relation(fields: [jobId], references: [id], onDelete: Restrict)
  changes         ProposalChange[]

  @@map("review_proposals")
}

model ProposalChange {
  id                String              @id @default(uuid()) @db.Uuid
  proposalId        String              @map("proposal_id") @db.Uuid
  position          Int
  targetKind        ProposalTargetKind  @map("target_kind")
  targetKey         String              @map("target_key") @db.VarChar(240)
  beforeHash        String?             @map("before_hash") @db.Char(64)
  afterBody         String              @map("after_body") @db.Text
  afterHash         String              @map("after_hash") @db.Char(64)
  rationale         String              @db.Text
  state             ProposalChangeState @default(PENDING)
  decidedAt         DateTime?           @map("decided_at") @db.Timestamptz(3)
  decidedById       String?             @map("decided_by_id") @db.Uuid
  appliedRevisionId String?             @map("applied_revision_id") @db.Uuid
  proposal          ReviewProposal      @relation(fields: [proposalId], references: [id], onDelete: Restrict)

  @@unique([proposalId, position], map: "proposal_changes_position_key")
  @@map("proposal_changes")
}

model PublicationJob {
  id                        String                        @id @default(uuid()) @db.Uuid
  publicationId             String                        @unique @map("publication_id") @db.Uuid
  situationId               String                        @map("situation_id") @db.Uuid
  targetRevisionId          String                        @map("target_revision_id") @db.Uuid
  checkoutId                String                        @map("checkout_id") @db.Uuid
  checkoutFence             BigInt                        @map("checkout_fence")
  sourceKind                ProductionSourceKind          @map("source_kind")
  state                     PublicationJobState           @default(REQUESTED)
  targetBundleHash          String                        @map("target_bundle_hash") @db.Char(64)
  baseBundleHash            String?                       @map("base_bundle_hash") @db.Char(64)
  expectedPointerGeneration BigInt?                       @map("expected_pointer_generation")
  observedReleaseId         String?                       @map("observed_release_id") @db.Uuid
  leadershipReleaseId       String?                       @unique @map("leadership_release_id") @db.Uuid
  leadershipManifestHash    String?                       @map("leadership_manifest_hash") @db.Char(64)
  previousReleaseId         String?                       @map("previous_release_id") @db.Uuid
  restorationParentId       String?                       @map("restoration_parent_id") @db.Uuid
  claimToken                String?                       @map("claim_token") @db.Uuid
  leaseExpiresAt            DateTime?                     @map("lease_expires_at") @db.Timestamptz(3)
  createdAt                 DateTime                      @default(now()) @map("created_at") @db.Timestamptz(3)
  startedAt                 DateTime?                     @map("started_at") @db.Timestamptz(3)
  finishedAt                DateTime?                     @map("finished_at") @db.Timestamptz(3)
  failureCode               String?                       @map("failure_code") @db.VarChar(100)
  situation                 Situation                     @relation(fields: [situationId], references: [id], onDelete: Restrict)
  targetRevision            DraftRevision                 @relation(fields: [targetRevisionId], references: [id], onDelete: Restrict)
  attempts                  PublicationAttempt[]
  events                    PublicationEvent[]
  receipt                   VerificationReceipt?
  candidateSnapshot         PublicationCandidateSnapshot?
  backups                   BackupReceipt[]

  @@index([state, createdAt], map: "publication_jobs_queue_idx")
  @@index([situationId, state], map: "publication_jobs_situation_idx")
  @@map("publication_jobs")
}

model PublicationCandidateSnapshot {
  id                        String         @id @default(uuid()) @db.Uuid
  jobId                     String         @unique @map("job_id") @db.Uuid
  releaseId                 String         @unique @map("release_id") @db.Uuid
  parentReleaseId           String         @map("parent_release_id") @db.Uuid
  expectedPointerGeneration BigInt         @map("expected_pointer_generation")
  manifestHash              String         @map("manifest_hash") @db.Char(64)
  manifestBody              String         @map("manifest_body") @db.Text
  artifactCount             Int            @map("artifact_count")
  edgeCount                 Int            @map("edge_count")
  totalByteLength           BigInt         @map("total_byte_length")
  assembly                  Json
  createdAt                 DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  job                       PublicationJob @relation(fields: [jobId], references: [id], onDelete: Restrict)

  @@map("publication_candidate_snapshots")
}

model PublicationAttempt {
  id              String         @id @default(uuid()) @db.Uuid
  jobId           String         @map("job_id") @db.Uuid
  attempt         Int
  startedAt       DateTime       @default(now()) @map("started_at") @db.Timestamptz(3)
  finishedAt      DateTime?      @map("finished_at") @db.Timestamptz(3)
  reconciledState Json?          @map("reconciled_state")
  failureCode     String?        @map("failure_code") @db.VarChar(100)
  job             PublicationJob @relation(fields: [jobId], references: [id], onDelete: Restrict)

  @@unique([jobId, attempt], map: "publication_attempts_attempt_key")
  @@map("publication_attempts")
}

model PublicationEvent {
  id        String               @id @default(uuid()) @db.Uuid
  jobId     String               @map("job_id") @db.Uuid
  sequence  Int
  kind      PublicationEventKind
  payload   Json
  createdAt DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  job       PublicationJob       @relation(fields: [jobId], references: [id], onDelete: Restrict)

  @@unique([jobId, sequence], map: "publication_events_sequence_key")
  @@map("publication_events")
}

model VerificationReceipt {
  id                        String         @id @default(uuid()) @db.Uuid
  jobId                     String         @unique @map("job_id") @db.Uuid
  expectedReleaseId         String         @map("expected_release_id") @db.Uuid
  expectedManifestHash      String         @map("expected_manifest_hash") @db.Char(64)
  observedDatabaseReleaseId String         @map("observed_database_release_id") @db.Uuid
  observedDatabaseHash      String         @map("observed_database_hash") @db.Char(64)
  observedRuntimeReleaseId  String         @map("observed_runtime_release_id") @db.Uuid
  observedRuntimeHash       String         @map("observed_runtime_hash") @db.Char(64)
  pointerGeneration         BigInt         @map("pointer_generation")
  verifiedAt                DateTime       @default(now()) @map("verified_at") @db.Timestamptz(3)
  job                       PublicationJob @relation(fields: [jobId], references: [id], onDelete: Restrict)

  @@map("verification_receipts")
}

model AuditEvent {
  id          String   @id @default(uuid()) @db.Uuid
  actorId     String?  @map("actor_id") @db.Uuid
  action      String   @db.VarChar(100)
  subjectType String   @map("subject_type") @db.VarChar(80)
  subjectId   String   @map("subject_id") @db.VarChar(160)
  payload     Json
  occurredAt  DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)
  actor       User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([subjectType, subjectId, occurredAt], map: "audit_subject_time_idx")
  @@map("audit_events")
}

model BackupReceipt {
  id                 String          @id @default(uuid()) @db.Uuid
  publicationJobId   String?         @map("publication_job_id") @db.Uuid
  state              BackupState     @default(QUEUED)
  destinationId      String          @map("destination_id") @db.VarChar(120)
  objectKey          String?         @map("object_key") @db.VarChar(500)
  checksum           String?         @db.Char(64)
  encrypted          Boolean         @default(true)
  byteLength         BigInt?         @map("byte_length")
  startedAt          DateTime?       @map("started_at") @db.Timestamptz(3)
  verifiedAt         DateTime?       @map("verified_at") @db.Timestamptz(3)
  failureCode        String?         @map("failure_code") @db.VarChar(100)
  restoreDrillAt     DateTime?       @map("restore_drill_at") @db.Timestamptz(3)
  restoreDrillResult String?         @map("restore_drill_result") @db.VarChar(120)
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  publicationJob     PublicationJob? @relation(fields: [publicationJobId], references: [id], onDelete: Restrict)

  @@index([state, createdAt], map: "backup_receipts_state_time_idx")
  @@map("backup_receipts")
}

model ProcessHeartbeat {
  id         String   @id @db.VarChar(40)
  status     String   @db.VarChar(40)
  details    Json
  lastSeenAt DateTime @map("last_seen_at") @db.Timestamptz(3)

  @@map("process_heartbeats")
}
